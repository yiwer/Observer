# Non-secret paths and release references only. Never put keys or an email here.
OBSERVER_DEPLOY_DIR=/usr/local/lib/observer
OBSERVER_APP_IMAGE=observer:REPLACE_WITH_RELEASE_ID
OBSERVER_CADDY_IMAGE=caddy:2.10.2-alpine
OBSERVER_NODE_ID=observer-primary
OBSERVER_DOMAIN=REPLACE_WITH_AUTHORIZED_HOSTNAME
OBSERVER_DOCKER_GID=REPLACE_WITH_SOCKET_GID
OBSERVER_DATA_DIR=/srv/observer/data
OBSERVER_CONFIG_DIR=/etc/observer/config
OBSERVER_OWNER_TOKEN_PATH=/etc/observer/secrets/owner-token
OBSERVER_PROVIDER_SECRETS_DIR=/etc/observer/provider-secrets
OBSERVER_TLS_DIR=/srv/observer/tls
OBSERVER_AGENT_CONCURRENCY=2
OBSERVER_MIN_FREE_BYTES=536870912
OBSERVER_MIN_FREE_INODES=1024
# Backup mounts are used only by backup.compose.yaml, not by the production app.
OBSERVER_BACKUP_CONFIG_DIR=/etc/observer/backup
OBSERVER_BACKUP_AUTHORITY_DIR=/etc/observer/backup-authority
OBSERVER_BACKUP_SECRETS_DIR=/etc/observer/backup-secrets
OBSERVER_BACKUP_CONTROL_DIR=/srv/observer/backup-control
OBSERVER_RESTORE_DIR=/srv/observer/restores
